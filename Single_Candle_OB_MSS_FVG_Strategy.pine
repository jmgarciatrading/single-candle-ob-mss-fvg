//@version=6
strategy("Single Candle OB + MSS + FVG Strategy", shorttitle = "1C St", overlay = true,
     max_bars_back = 500, max_boxes_count = 200, max_lines_count = 500, max_labels_count = 100,
     pyramiding = 2, default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 100000, process_orders_on_close = true)

// The highlighted candle is the one that closes through the swing. The next
// candle confirms it when that swing is left strictly inside the body fair value
// gap between the previous candle and the confirming candle. The confirming
// candle's wick has to stay beyond the swing. A wick back through the swing
// is not a confirmation. The confirming candle's color does not matter.
// The box then covers
// only the break candle, with a dotted line at its midpoint. A wick that only
// tags the swing does not qualify. The swing is booked on that close even when
// the next candle does not leave it inside the gap. Limit at the swing draws
// the entry on the breached swing and extends the stop, the entry, and the
// target until a later candle trades that price. Its stop is the previous
// candle's low for a bullish signal and that candle's high for a bearish one.
// The strategy rests a limit on the candle after the mark. A stop traded before
// that limit cancels it. The confirm candle does not fill it. Market at close
// draws the entry on the close of the displacement candle. The next candle
// confirms the gap and does not set that price. The stop is the open of that
// same candle. The strategy sends the market order on that candle's close.
// The fill is that close. The stop price stays that candle's open. The stop
// order is sent on the candle after it, so the entry candle does not stop
// the trade out. Both sends that market order and rests the swing limit.
// Each leg uses Contracts. The lines stay on the signal.
// A stop traded after the drawing candle hides the mark. While liquidity is
// on, a later mark closes the open trade. That mark is the sweep validated by
// the lower-timeframe formation. The sweep candle itself leaves the trade open.
// Close Location skips a displacement, a flip, an opposite swing break, and a
// continuation whose close finishes inside that fraction of its own range.
// The default is 0, so the check is off. A weaker close still books the swing
// and leaves the working mark in place.
// The structure window defaults to 09:30 until 16:00 New York, every minute.
// A separate entry check refuses the order and the trade mark. It does not
// refuse the swing, the zone, the flip, or the continuation. The defaults
// refuse an order before 10:05, a six-bar range under 8 points, a long more
// than 22 points above that day's 09:30 open, and a stop wider than 30 points.
// 0 on each of those inputs turns that one check off.
// While a trade is in profit at the previous close, a later signal does not
// close it and does not reverse it. A trade opened before 15:55 is closed on
// the first bar at or after 15:55 in the same session.
// A later signal closes at that bar's close. TradingView does not move that
// fill back to the original stop. The stop order is what caps a live stop.

string GRP_COLORS = "Colors"
color bullObColor = input.color(color.rgb(30, 136, 229), "Bullish Displacement", group = GRP_COLORS)
color bearObColor = input.color(color.rgb(229, 57, 53), "Bearish Displacement", group = GRP_COLORS)

string GRP_STRUCTURE = "Structure"
int swingLength = input.int(1, "Swing Length", minval = 1, maxval = 50, group = GRP_STRUCTURE,
     tooltip = "Pivots become usable only after this many right-side bars have closed. 1 is the nearest one-candle swing. Raise it for a larger swing.")
int swingBreachLookback = input.int(2, "Swing Breach Lookback", minval = 0, maxval = 50, group = GRP_STRUCTURE,
     tooltip = "The marked candle is the one that closes through the swing. This is how many candles an unclaimed close-through stays open before it is booked. 0 books it on the break candle. A larger number waits until that window ends. The mark still needs the next candle to leave the swing inside a body fair value gap. A wick that never closes through does not book the swing.")
float closeLocation = input.float(0, "Close Location", minval = 0, maxval = 1, step = 0.05, group = GRP_STRUCTURE,
     tooltip = "The close has to finish in this fraction of the candle, measured from the break extreme. 0.75 keeps a bullish close in the top quarter and a bearish close in the bottom quarter. Equal to the fraction still marks. A weaker close does not arm, does not flip, and does not continue. The swing is still booked, and the working mark stays. 0 turns the check off.")

string GRP_DISPLAY = "Display"
const string DISPLAY_LATEST = "Latest"
const string DISPLAY_ALL = "All"
string displayMode = input.string(DISPLAY_LATEST, "Display Mode",
     options = [DISPLAY_LATEST, DISPLAY_ALL], group = GRP_DISPLAY)

string GRP_TARGET = "Target"
string targetChoice = input.string("4H", "Timeframe Target", options = ["Off", "1M", "5M", "15M", "1H", "4H", "Daily"], group = GRP_TARGET,
     tooltip = "Take profit is the newest confirmed swing on this timeframe beyond the entry. A bullish signal uses a swing high above that entry. A bearish signal uses a swing low below it. A wick through the swing does not skip it. Limit at the swing puts the stop on the previous candle's low for a bullish signal and on its high for a bearish signal. That distance starts at the breached swing. Market at close puts the stop on the open of the displacement candle and measures the distance from that candle's close. When no target swing is beyond the entry, the target is two times that distance. Off does not use a swing. Max Target then sets the target, and 0 leaves it empty. Min RR checks the final target: the swing, that two-times fallback, or the Max Target cap. Equal to the multiple still marks. Min RR above 0 leaves the candle unmarked when the final target is closer than that multiple. A flip uses the same multiple. A timeframe below the chart leaves the swing target off. Min RR above 0 then leaves the candle unmarked.")
int minRr = input.int(2, "Min RR", minval = 0, maxval = 50, group = GRP_TARGET,
     tooltip = "The candle is not marked when the final target is closer than this multiple of the stop distance. Limit at the swing measures that distance from the breached swing to the previous candle. Market at close measures it from the close of the displacement candle to the open of that same candle. The final target is the higher-timeframe swing, the two-times fallback when no swing is beyond the entry, or the Max Target cap when that cap is closer. A flip uses the same multiple. Equal to the multiple still marks. 0 turns this check off. The break is still booked. The default is 2.")
int maxTarget = input.int(14, "Max Target", minval = 0, maxval = 50, group = GRP_TARGET,
     tooltip = "When Timeframe Target is Off, the target is this multiple of the distance from the breached swing to the stop. 3 draws it at 1:3, and 0 leaves the target empty. When a swing timeframe is selected, this caps a swing farther than this multiple. A closer swing stays. 0 leaves that swing unchanged. The two-times fallback stays at two times. Min RR can leave that fallback unmarked when two is below the multiple.")
int targetSwingLength = input.int(6, "Target Swing Length", minval = 1, maxval = 20, group = GRP_TARGET,
     tooltip = "Bars required on each side of a target-timeframe pivot. The pivot is usable only after that many later candles have closed.")

string GRP_LIQUIDITY = "Liquidity"
string liquidityChoice = input.string("4H", "Liquidity Timeframe", options = ["Off", "Same", "1M", "5M", "15M", "1H", "4H", "Daily"], group = GRP_LIQUIDITY,
     tooltip = "The mark waits for a chart candle that sweeps this timeframe and closes back inside. Same uses Timeframe Target. The pool is the last closed candle on that timeframe. A bullish sweep trades below that candle's low and the close finishes back inside it. A bearish sweep trades above that candle's high and the close finishes back inside it. Off leaves this filter out. A timeframe below the chart leaves it out. The break is still booked. An open trade closes when a later mark validates the next sweep. The sweep candle does not close the trade. A later close through the swept side invalidates that sweep before the mark. A wick through that side does not. The next sweep of that side starts again. A continuation follows that close. The breaching candle is swept, then a later candle closes through that sweep. The entry is that candle's close and the stop is its open. The strategy sends a market order on that close. The fill is that close.")
string keyLevelChoice = input.string("Off", "Key Level", options = ["Off", "Same", "1M", "5M", "15M", "1H", "4H", "Daily"], group = GRP_LIQUIDITY,
     tooltip = "Off leaves the mark on Liquidity Timeframe alone. Any other choice starts when an untapped high or low of this timeframe is swept or closed through. A chart candle then has to close back inside that candle's range. Liquidity Lookback counts the bars after that close. The liquidity sweep can be older and stays valid until a close through its side. Same uses Timeframe Target. A timeframe below the chart leaves this out. With this set and Liquidity Timeframe off, nothing is marked.")
int liquidityLookback = input.int(1, "Liquidity Lookback", minval = 0, maxval = 500, group = GRP_LIQUIDITY,
     tooltip = "Chart candles. 1 keeps a liquidity sweep on this candle or the candle before it. 0 allows only a sweep on the signal candle. On a 15-minute chart, 1 is 15 minutes. A flip uses this count. With Key Level on, the count starts when a chart candle closes back inside the key range. The liquidity sweep can be older.")
bool useVwapChase = input.bool(false, "VWAP Chase", group = GRP_LIQUIDITY,
     tooltip = "On skips a continuation that has already run too far past the session VWAP. Off keeps every continuation. Swing breaks and flips are not filtered. The VWAP is the chart session VWAP.")
float vwapChase = input.float(4, "VWAP Chase R", minval = 0, step = 0.25, group = GRP_LIQUIDITY,
     tooltip = "Stop distances past the session VWAP. 4 skips a continuation whose close is more than four times its open-to-close distance beyond VWAP. A bullish continuation is measured above VWAP. A bearish continuation is measured below it. A continuation on the other side of VWAP is kept. Equal to the multiple still marks. 0 skips any continuation that has closed past VWAP. The checkbox turns the filter off.")

string GRP_TIME = "Time Window"
bool useTimeWindow = input.bool(true, "Use Time Window", group = GRP_TIME)
int startHour = input.int(9, "Start Time", minval = 0, maxval = 23, group = GRP_TIME, inline = "start")
int startMinute = input.int(30, "Minute", minval = 0, maxval = 59, group = GRP_TIME, inline = "start")
int endHour = input.int(16, "End Time", minval = 0, maxval = 23, group = GRP_TIME, inline = "end")
int endMinute = input.int(0, "Minute", minval = 0, maxval = 59, group = GRP_TIME, inline = "end")
int minuteWindowStart = input.int(0, "Minute Window", minval = 0, maxval = 59, group = GRP_TIME, inline = "minute",
     tooltip = "Used only while Use Time Window is on. 1 to 55 keeps :15, :30, and :45 on a 15-minute chart and drops the :00 candle. 0 to 60 keeps the whole hour.")
int minuteWindowEnd = input.int(60, "to", minval = 1, maxval = 60, group = GRP_TIME, inline = "minute",
     tooltip = "Exclusive end minute in the same hour. 15 excludes the candle that opens at minute 15. 60 includes the full hour.")
string timeZone = input.string("America/New_York", "Time Zone", group = GRP_TIME,
     tooltip = "Use an IANA timezone. America/New_York follows US daylight-saving transitions.")
bool skipSundays = input.bool(false, "Skip Sundays", group = GRP_TIME,
     tooltip = "A Sunday candle does not arm a displacement, does not book a swing, and does not flip a mark. The candle after the break that falls on Sunday does not confirm the gap. An open trade keeps its stop and target. A working limit can still fill or cancel, because the market is open. Higher-timeframe swings still include Sunday prices.")

string GRP_ENTRY = "Entry"
const string ENTRY_LIMIT = "Limit at the swing"
const string ENTRY_MARKET = "Market at close"
const string ENTRY_BOTH = "Both"
string entryModel = input.string(ENTRY_MARKET, "Entry Model",
     options = [ENTRY_LIMIT, ENTRY_MARKET, ENTRY_BOTH], group = GRP_ENTRY,
     tooltip = "Limit at the swing rests a limit on the candle after the mark. Its stop is the previous candle's low for a bullish signal and that candle's high for a bearish signal. The mark's candle does not fill that limit. Market at close sends a market order on the displacement candle, and the black line is that candle's close. For a swing break that is the candle that closed through the swing. The next candle confirms the gap and does not set the price. When the gap does not confirm, that fill is closed. For a flip the displacement candle is the flip candle. The stop is the open of that same candle and is attached on the next candle. The target and Min RR are measured from that close to that open. A close that does not clear Min RR is left unmarked. The market order fills on that candle's close. Both sends that market order and rests that swing limit. Each leg uses Contracts and keeps its own Min RR. A leg that misses Min RR is left off. The market fill can confirm outside the window. The limit is added only when the confirming candle is inside the window.")
bool marketEntry = entryModel == ENTRY_MARKET
bool bothEntry = entryModel == ENTRY_BOTH
int entryFromHour = input.int(10, "Entry From", minval = 0, maxval = 23, group = GRP_ENTRY, inline = "entryfrom",
     tooltip = "No new order before this clock in Time Zone. The swing, the zone, a flip, and a continuation are still stored. 0:00 turns this check off. The default is 10:05. The structure window still starts at its own Start Time.")
int entryFromMinute = input.int(5, "Minute", minval = 0, maxval = 59, group = GRP_ENTRY, inline = "entryfrom",
     tooltip = "Minute of Entry From. 10 and 5 is 10:05. A bar at that minute is allowed. An earlier bar can still update structure.")
float minRange = input.float(8, "Min Range", minval = 0, step = 0.25, group = GRP_ENTRY,
     tooltip = "The last six chart bars, including this bar, have to span at least this many points. 0 turns the check off.")
float longExtension = input.float(22, "Long Extension", minval = 0, step = 0.25, group = GRP_ENTRY,
     tooltip = "A long is refused when its fill is more than this many points above the open of the first bar at or after 09:30 in Time Zone. 0 turns the check off. Shorts are not filtered. A refused long still updates structure.")
float maxStop = input.float(30, "Max Stop", minval = 0, step = 0.25, group = GRP_ENTRY,
     tooltip = "An order is refused when the distance from the fill to its stop is wider than this. 0 turns the check off. A taken trade keeps its own stop. This does not widen it.")

string GRP_ORDERS = "Orders"
int contracts = input.int(1, "Contracts", minval = 1, group = GRP_ORDERS,
     tooltip = "Fixed size for each order. Both can fill the market order and the swing limit, so both fills are two times this number. A market order is sent on the displacement candle and fills on that close. A limit is sent on the candle after the mark. A later candle that trades the stop before a limit fill cancels that limit. A market order is left to fill. An open trade keeps its own stop and target.")
bool holdWinner = input.bool(true, "Hold Winner", group = GRP_ORDERS,
     tooltip = "While the open trade is in profit at the previous close, a later signal does not close it and does not reverse it. A trade at a loss, or exactly at the entry, still closes on the next signal. The original stop and target stay.")
bool sessionFlat = input.bool(true, "Flat At 15:55", group = GRP_ORDERS,
     tooltip = "A trade opened before 15:55 in Time Zone, on that same calendar day, is closed on the first bar at or after 15:55. The entry bar is left alone. A fill at 15:55 or later is not flattened. A trade that is still open after midnight is not flattened the next day.")

string targetPine = targetChoice == "Daily" ? "D" : targetChoice == "4H" ? "240" : targetChoice == "1H" ? "60" : targetChoice == "15M" ? "15" : targetChoice == "5M" ? "5" : targetChoice == "1M" ? "1" : timeframe.period
bool targetTfOk = targetChoice == "Off" or timeframe.in_seconds(targetPine) >= timeframe.in_seconds()
bool swingTargetOn = targetChoice != "Off" and targetTfOk
bool targetOn = swingTargetOn or maxTarget > 0
string safeTargetPine = swingTargetOn ? targetPine : timeframe.period
string liquiditySelected = liquidityChoice == "Same" ? targetChoice : liquidityChoice
string liquidityPine = liquiditySelected == "Daily" ? "D" : liquiditySelected == "4H" ? "240" : liquiditySelected == "1H" ? "60" : liquiditySelected == "15M" ? "15" : liquiditySelected == "5M" ? "5" : liquiditySelected == "1M" ? "1" : timeframe.period
bool liquidityTfOk = liquiditySelected != "Off" and timeframe.in_seconds(liquidityPine) >= timeframe.in_seconds()
bool liquidityOn = liquidityChoice != "Off" and liquidityTfOk
string safeLiquidityPine = liquidityOn ? liquidityPine : timeframe.period

if barstate.isfirst and useTimeWindow and minuteWindowStart >= minuteWindowEnd
    runtime.error("Minute window end must be later than the minute window start.")

const int MAX_STORED = 100
const int DIR_BULL = 1
const int DIR_BEAR = -1
const int KIND_MSS = 1
const int KIND_BOS = 2

type Formation
    int direction
    int kind
    int creationBar
    int swingBar
    float level
    int obBar
    float obTop
    float obBottom
    int fvgLeftBar
    int fvgRightBar
    float fvgTop
    float fvgBottom
    bool obMitigated
    bool fvgMitigated
    bool isVisible
    float impulseHigh
    float impulseLow
    float stopPrice
    float targetPrice
    int signalTime
    int targetAnchorTime
    bool underMinRr
    bool flipped
    box obBox
    box fvgBox
    line levelLine
    label levelLabel
    line stopLine
    line targetLine
    line entryLine
    int entryDrawnBar = na
    bool entryMitigated = false
    int sweepBar = na
    float sweepPrice = na
    bool atClose = false
    bool protectWaiting = false
    bool limitWaiting = false
    float opposingSwing = na
    bool closeLines = false
    float swingLevel = na
    float swingStop = na
    float swingTarget = na
    line swingEntryLine = na
    line swingStopLine = na
    line swingTargetLine = na
    bool swingLimitWaiting = false
    bool swingEntryMitigated = false
    line sweepLine = na
    label sweepTag = na
    line keySweepLine = na
    label keySweepTag = na

var array<Formation> formations = array.new<Formation>()
var int structureDirection = 0
// A market order is sent on the displacement candle. The next candle attaches the stop, or closes the fill when the gap does not confirm.
var bool marketOrderLive = false
// A function cannot assign a global. The array element can change from a function.
var int[] pendingCreation = array.new<int>(1, na)

f_clearPending() =>
    strategy.cancel("1C Long")
    strategy.cancel("1C Short")
    strategy.cancel("1C Long Limit")
    strategy.cancel("1C Short Limit")
    array.set(pendingCreation, 0, na)
    int pendingCount = array.size(formations)
    if pendingCount > 0
        for pendingIndex = 0 to pendingCount - 1
            Formation pendingFormation = array.get(formations, pendingIndex)
            pendingFormation.limitWaiting := false
            pendingFormation.protectWaiting := false
            pendingFormation.swingLimitWaiting := false

// The stop price is the displacement candle's open. The order goes out on the next candle, because that open is inside the entry candle and would close the trade on the fill.
f_protect(Formation formation) =>
    if formation.direction == DIR_BULL
        if na(formation.targetPrice)
            strategy.exit("1C Exit", from_entry = "1C Long", stop = formation.stopPrice)
        else
            strategy.exit("1C Exit", from_entry = "1C Long", stop = formation.stopPrice, limit = formation.targetPrice)
    else
        if na(formation.targetPrice)
            strategy.exit("1C Exit", from_entry = "1C Short", stop = formation.stopPrice)
        else
            strategy.exit("1C Exit", from_entry = "1C Short", stop = formation.stopPrice, limit = formation.targetPrice)

f_protectSwing(Formation formation) =>
    if formation.direction == DIR_BULL
        if na(formation.swingTarget)
            strategy.exit("1C Exit Limit", from_entry = "1C Long Limit", stop = formation.swingStop)
        else
            strategy.exit("1C Exit Limit", from_entry = "1C Long Limit", stop = formation.swingStop, limit = formation.swingTarget)
    else
        if na(formation.swingTarget)
            strategy.exit("1C Exit Limit", from_entry = "1C Short Limit", stop = formation.swingStop)
        else
            strategy.exit("1C Exit Limit", from_entry = "1C Short Limit", stop = formation.swingStop, limit = formation.swingTarget)

f_closeMarket(int direction) =>
    if direction == DIR_BULL
        strategy.close("1C Long", comment = "Unconfirmed")
    else if direction == DIR_BEAR
        strategy.close("1C Short", comment = "Unconfirmed")
    f_clearPending()

// Entry checks read these. They stay outside the function so each bar has one value.
// They are declared before the order functions. PyneCore does not hoist a later function.
int entryFromMinuteOfDay = entryFromHour * 60 + entryFromMinute
var float sessionOpen = na
var int sessionDay = na
int nyDay = year(time, timeZone) * 10000 + month(time, timeZone) * 100 + dayofmonth(time, timeZone)
int nyMinute = hour(time, timeZone) * 60 + minute(time, timeZone)
if nyMinute >= 9 * 60 + 30 and nyDay != sessionDay
    sessionDay := nyDay
    sessionOpen := open
float windowSpan = ta.highest(high, 6) - ta.lowest(low, 6)

f_entryOk(int direction, float entryPrice, float stopPrice) =>
    bool timeOk = entryFromMinuteOfDay == 0 or nyMinute >= entryFromMinuteOfDay
    bool rangeOk = minRange <= 0 or (not na(windowSpan) and windowSpan >= minRange)
    bool longOk = longExtension <= 0 or direction != DIR_BULL or na(sessionOpen) or entryPrice - sessionOpen <= longExtension
    bool riskOk = maxStop <= 0 or na(entryPrice) or na(stopPrice) or math.abs(entryPrice - stopPrice) <= maxStop
    timeOk and rangeOk and longOk and riskOk

f_holdingWinner() =>
    bool longWin = strategy.position_size > 0 and close[1] > strategy.position_avg_price
    bool shortWin = strategy.position_size < 0 and close[1] < strategy.position_avg_price
    holdWinner and (longWin or shortWin)

f_showOrderOk(Formation formation) =>
    bool marketFill = marketEntry or formation.atClose
    float entryPrice = marketFill ? close : formation.level
    f_entryOk(formation.direction, entryPrice, formation.stopPrice)

f_place(Formation formation) =>
    bool hasEntry = not na(formation.level) and not na(formation.stopPrice)
    bool stopOk = formation.direction == DIR_BULL ? formation.stopPrice < formation.level : formation.stopPrice > formation.level
    bool hasTarget = not na(formation.targetPrice)
    bool targetSide = formation.direction == DIR_BULL ? formation.targetPrice > formation.level : formation.targetPrice < formation.level
    bool targetOk = minRr > 0 ? hasTarget and targetSide : not hasTarget or targetSide
    bool useMarket = marketEntry or formation.atClose
    float placedEntry = useMarket ? close : formation.level
    bool placedOk = f_entryOk(formation.direction, placedEntry, formation.stopPrice)
    if strategy.position_size == 0 and hasEntry and stopOk and targetOk and placedOk
        f_clearPending()
        array.set(pendingCreation, 0, formation.creationBar)
        if formation.direction == DIR_BULL
            if useMarket
                strategy.entry("1C Long", strategy.long, qty = contracts)
                formation.protectWaiting := true
            else
                strategy.entry("1C Long", strategy.long, qty = contracts, limit = formation.level)
                f_protect(formation)
                formation.protectWaiting := false
        else
            if useMarket
                strategy.entry("1C Short", strategy.short, qty = contracts)
                formation.protectWaiting := true
            else
                strategy.entry("1C Short", strategy.short, qty = contracts, limit = formation.level)
                f_protect(formation)
                formation.protectWaiting := false

// The swing limit can be open beside the market fill. It does not cancel that fill.
f_placeSwing(Formation formation) =>
    bool hasEntry = not na(formation.swingLevel) and not na(formation.swingStop)
    bool stopOk = formation.direction == DIR_BULL ? formation.swingStop < formation.swingLevel : formation.swingStop > formation.swingLevel
    bool hasTarget = not na(formation.swingTarget)
    bool targetSide = formation.direction == DIR_BULL ? formation.swingTarget > formation.swingLevel : formation.swingTarget < formation.swingLevel
    bool targetOk = minRr > 0 ? hasTarget and targetSide : not hasTarget or targetSide
    bool placed = false
    bool swingOk = f_entryOk(formation.direction, formation.swingLevel, formation.swingStop)
    if hasEntry and stopOk and targetOk and swingOk
        if formation.direction == DIR_BULL
            strategy.entry("1C Long Limit", strategy.long, qty = contracts, limit = formation.swingLevel)
            f_protectSwing(formation)
            placed := true
        else
            strategy.entry("1C Short Limit", strategy.short, qty = contracts, limit = formation.swingLevel)
            f_protectSwing(formation)
            placed := true
    placed

f_inWindowAt(int t) =>
    if not useTimeWindow
        true
    else
        int barMinutes = hour(t, timeZone) * 60 + minute(t, timeZone)
        int startMinutes = startHour * 60 + startMinute
        int endMinutes = endHour * 60 + endMinute
        bool inside = startMinutes < endMinutes ?
             (barMinutes >= startMinutes and barMinutes < endMinutes) :
             startMinutes > endMinutes ?
             (barMinutes >= startMinutes or barMinutes < endMinutes) : true
        int minuteOfHour = minute(t, timeZone)
        bool minuteInside = minuteOfHour >= minuteWindowStart and minuteOfHour < minuteWindowEnd
        inside and minuteInside

f_inWindow() =>
    f_inWindowAt(time)

f_touched(float zoneTop, float zoneBottom) =>
    high >= zoneBottom and low <= zoneTop

var label[] sweepLabels = array.new<label>()
var line[] sweepLines = array.new<line>()
var int[] sweepLabelBars = array.new<int>()
var int[] sweepLabelSides = array.new<int>()
var int[] sweepLabelKinds = array.new<int>()

f_releaseMark(line markLine, label markLabel) =>
    if not na(markLabel)
        int count = array.size(sweepLabels)
        if count > 0
            for index = 0 to count - 1
                if array.get(sweepLabels, index) == markLabel
                    array.remove(sweepLabels, index)
                    array.remove(sweepLines, index)
                    array.remove(sweepLabelBars, index)
                    array.remove(sweepLabelSides, index)
                    array.remove(sweepLabelKinds, index)
                    break
        label.delete(markLabel)
    if not na(markLine)
        line.delete(markLine)

f_deleteVisuals(Formation formation) =>
    if formation.isVisible
        box.delete(formation.obBox)
        box.delete(formation.fvgBox)
        line.delete(formation.levelLine)
        label.delete(formation.levelLabel)
        line.delete(formation.stopLine)
        line.delete(formation.targetLine)
        line.delete(formation.entryLine)
        line.delete(formation.swingEntryLine)
        line.delete(formation.swingStopLine)
        line.delete(formation.swingTargetLine)
        f_releaseMark(formation.sweepLine, formation.sweepTag)
        f_releaseMark(formation.keySweepLine, formation.keySweepTag)
        formation.obBox := na
        formation.fvgBox := na
        formation.levelLine := na
        formation.levelLabel := na
        formation.stopLine := na
        formation.targetLine := na
        formation.entryLine := na
        formation.swingEntryLine := na
        formation.swingStopLine := na
        formation.swingTargetLine := na
        formation.sweepLine := na
        formation.sweepTag := na
        formation.keySweepLine := na
        formation.keySweepTag := na
        formation.isVisible := false

f_reclaimIndex() =>
    int result = -1
    int count = array.size(formations)
    if count > 0
        for index = 0 to count - 1
            Formation formation = array.get(formations, index)
            if result == -1 and formation.obMitigated and formation.fvgMitigated
                result := index
    result

f_render(Formation formation) =>
    color candleColor = formation.direction == DIR_BULL ? bullObColor : bearObColor
    float midpoint = (formation.impulseHigh + formation.impulseLow) / 2
    formation.obBox := box.new(formation.creationBar, formation.impulseHigh, formation.creationBar + 1,
         formation.impulseLow, xloc = xloc.bar_index, border_color = candleColor,
         bgcolor = color.new(candleColor, 82))
    formation.levelLine := line.new(formation.creationBar, midpoint, formation.creationBar + 1, midpoint,
         xloc = xloc.bar_index, color = candleColor, style = line.style_dotted, width = 1)
    // Limit at the swing draws the stop from the previous candle. Market at close draws it on the displacement candle, at that candle's open.
    bool closeAnchor = marketEntry or formation.atClose or formation.closeLines
    if closeAnchor
        formation.stopLine := line.new(formation.creationBar, formation.stopPrice, formation.creationBar + 1,
             formation.stopPrice, xloc = xloc.bar_index, color = color.red, width = 2)
    else
        formation.stopLine := line.new(formation.creationBar - 1, formation.stopPrice, formation.creationBar + 1,
             formation.stopPrice, xloc = xloc.bar_index, color = color.red, width = 2)
    // The entry is the breached swing, or the close of the displacement candle.
    if not na(formation.level)
        if closeAnchor
            formation.entryLine := line.new(formation.creationBar, formation.level, formation.creationBar + 1,
                 formation.level, xloc = xloc.bar_index, color = color.black, width = 2)
        else
            formation.entryLine := line.new(formation.creationBar - 1, formation.level, formation.creationBar + 1,
                 formation.level, xloc = xloc.bar_index, color = color.black, width = 2)
    formation.entryDrawnBar := bar_index
    if not na(formation.targetPrice)
        formation.targetLine := line.new(formation.creationBar, formation.targetPrice, formation.creationBar + 1,
             formation.targetPrice, xloc = xloc.bar_index, color = color.green, width = 1)
    if not na(formation.swingLevel) and not na(formation.swingStop)
        formation.swingStopLine := line.new(formation.creationBar - 1, formation.swingStop, formation.creationBar + 1,
             formation.swingStop, xloc = xloc.bar_index, color = color.red, width = 2)
        formation.swingEntryLine := line.new(formation.creationBar - 1, formation.swingLevel, formation.creationBar + 1,
             formation.swingLevel, xloc = xloc.bar_index, color = color.black, width = 2)
        if not na(formation.swingTarget)
            formation.swingTargetLine := line.new(formation.creationBar, formation.swingTarget, formation.creationBar + 1,
                 formation.swingTarget, xloc = xloc.bar_index, color = color.green, width = 1)
    formation.isVisible := true

f_store(Formation formation) =>
    bool stored = false
    if array.size(formations) >= MAX_STORED
        int reclaimIndex = f_reclaimIndex()
        if reclaimIndex >= 0
            Formation reclaimed = array.remove(formations, reclaimIndex)
            f_deleteVisuals(reclaimed)
    if array.size(formations) < MAX_STORED
        array.push(formations, formation)
        stored := true
    stored

f_show(Formation formation, bool placeOrder) =>
    bool orderOk = f_showOrderOk(formation)
    bool holding = f_holdingWinner()
    bool drawMark = not placeOrder or (strategy.position_size == 0 and orderOk) or (strategy.position_size != 0 and liquidityOn and not holding)
    if drawMark
        if displayMode == DISPLAY_LATEST
            int count = array.size(formations)
            if count > 0
                for index = 0 to count - 1
                    Formation stored = array.get(formations, index)
                    if stored.isVisible
                        f_deleteVisuals(stored)
        f_render(formation)
        if marketEntry or formation.atClose or formation.closeLines
            formation.entryMitigated := true
    // A new mark while flat replaces the working order. While liquidity is on,
    // a new mark closes the open trade. The mark is the sweep validated by this
    // formation, so the sweep candle itself does not close the trade. The new
    // mark does not send an order while that close is still working. A market
    // order sent on the displacement candle is already filled, so that confirm
    // draws here and leaves the position open. A refused entry is not drawn.
    // A winner is left open.
    if placeOrder
        if strategy.position_size == 0
            if orderOk
                if marketEntry or formation.atClose
                    f_place(formation)
                    formation.limitWaiting := false
                else
                    f_clearPending()
                    formation.limitWaiting := true
        else if liquidityOn
            if not holding
                if strategy.position_size > 0
                    strategy.close("1C Long", comment = "Formation")
                    strategy.close("1C Long Limit", comment = "Formation")
                else
                    strategy.close("1C Short", comment = "Formation")
                    strategy.close("1C Short Limit", comment = "Formation")
                strategy.cancel("1C Long Limit")
                strategy.cancel("1C Short Limit")
                formation.limitWaiting := false
                formation.swingLimitWaiting := false

// Closed target-timeframe candles. A pivot needs Target Swing Length bars on
// each side, so it is stored only after those later candles have closed.
[closedTargetTime, closedTargetHigh, closedTargetLow] = request.security(
     syminfo.tickerid, safeTargetPine, [time[1], high[1], low[1]], lookahead = barmerge.lookahead_on)

var float[] targetHighs = array.new<float>()
var float[] targetLows = array.new<float>()
var int[] targetTimes = array.new<int>()
var float[] targetSwingPrices = array.new<float>()
var int[] targetSwingKinds = array.new<int>()
var int[] targetSwingTimes = array.new<int>()
var int lastTargetTime = na
int targetPivotWindow = targetSwingLength * 2 + 1

if swingTargetOn and not na(closedTargetTime) and (na(lastTargetTime) or closedTargetTime != lastTargetTime)
    lastTargetTime := closedTargetTime
    array.push(targetHighs, closedTargetHigh)
    array.push(targetLows, closedTargetLow)
    array.push(targetTimes, closedTargetTime)
    if array.size(targetHighs) > targetPivotWindow
        array.shift(targetHighs)
        array.shift(targetLows)
        array.shift(targetTimes)
    if array.size(targetHighs) == targetPivotWindow
        float targetPivotHigh = array.get(targetHighs, targetSwingLength)
        float targetPivotLow = array.get(targetLows, targetSwingLength)
        bool isTargetHigh = true
        bool isTargetLow = true
        for pivotIndex = 0 to targetPivotWindow - 1
            if pivotIndex != targetSwingLength
                if array.get(targetHighs, pivotIndex) >= targetPivotHigh
                    isTargetHigh := false
                if array.get(targetLows, pivotIndex) <= targetPivotLow
                    isTargetLow := false
        int targetPivotTime = array.get(targetTimes, targetSwingLength)
        if isTargetHigh
            array.push(targetSwingPrices, targetPivotHigh)
            array.push(targetSwingKinds, 1)
            array.push(targetSwingTimes, targetPivotTime)
        if isTargetLow
            array.push(targetSwingPrices, targetPivotLow)
            array.push(targetSwingKinds, -1)
            array.push(targetSwingTimes, targetPivotTime)
        while array.size(targetSwingPrices) > 50
            array.shift(targetSwingPrices)
            array.shift(targetSwingKinds)
            array.shift(targetSwingTimes)

// The pool is the last closed liquidity-timeframe candle. A chart candle sweeps
// it by trading beyond one side and closing back inside that candle. Later taps
// of that same candle keep the first tap as the label anchor. A later close
// through the swept side invalidates that sweep before the mark. A wick does not.
[closedLiqTime, closedLiqHigh, closedLiqLow] = request.security(
     syminfo.tickerid, safeLiquidityPine, [time[1], high[1], low[1]], lookahead = barmerge.lookahead_on)

var int lastBullSweepBar = na
var int lastBearSweepBar = na
var float lastBullSweepPrice = na
var float lastBearSweepPrice = na
var int bullSweepCandle = na
var int bearSweepCandle = na
var int firstBullSweepBar = na
var int firstBearSweepBar = na
var float firstBullSweepPrice = na
var float firstBearSweepPrice = na
var float bullSweepLevel = na
var float bearSweepLevel = na
var bool bullSweepValid = false
var bool bearSweepValid = false
var int bullBreachBar = na
var float bullBreachHigh = na
var float bullBreachLow = na
var bool bullBreachSwept = false
var int bearBreachBar = na
var float bearBreachHigh = na
var float bearBreachLow = na
var bool bearBreachSwept = false
var int continuationDir = 0
var int bullContSweepBar = na
var float bullContSweepPrice = na
var int bearContSweepBar = na
var float bearContSweepPrice = na
if barstate.isconfirmed and liquidityOn and not na(closedLiqTime) and not na(closedLiqHigh) and not na(closedLiqLow) and closedLiqHigh > closedLiqLow
    bool sweptLow = low < closedLiqLow and close > closedLiqLow and close < closedLiqHigh
    bool sweptHigh = high > closedLiqHigh and close < closedLiqHigh and close > closedLiqLow
    if sweptLow
        lastBullSweepBar := bar_index
        lastBullSweepPrice := low
        bullSweepLevel := closedLiqLow
        bullSweepValid := true
        if na(bullSweepCandle) or bullSweepCandle != closedLiqTime
            bullSweepCandle := closedLiqTime
            firstBullSweepBar := bar_index
            firstBullSweepPrice := low
    if sweptHigh
        lastBearSweepBar := bar_index
        lastBearSweepPrice := high
        bearSweepLevel := closedLiqHigh
        bearSweepValid := true
        if na(bearSweepCandle) or bearSweepCandle != closedLiqTime
            bearSweepCandle := closedLiqTime
            firstBearSweepBar := bar_index
            firstBearSweepPrice := high
    // The sweep candle closed back inside. A later close through that side,
    // before the mark, drops the sweep and starts a continuation. The breaching
    // candle is swept, then a later candle closes through that sweep.
    continuationDir := 0
    if not na(bullBreachBar) and bar_index != bullBreachBar
        bool sweptBreach = high > bullBreachHigh and close < bullBreachHigh and close > bullBreachLow
        bool closedBreach = close > bullBreachHigh
        if not bullBreachSwept and sweptBreach
            bullBreachSwept := true
            bullContSweepBar := bar_index
            bullContSweepPrice := high
        else if bullBreachSwept and closedBreach
            continuationDir := DIR_BULL
            bullBreachBar := na
            bullBreachSwept := false
        else if closedBreach
            bullBreachBar := bar_index
            bullBreachHigh := high
            bullBreachLow := low
            bullBreachSwept := false
        else if close < bullBreachLow
            bullBreachBar := na
            bullBreachSwept := false
    if not na(bearBreachBar) and bar_index != bearBreachBar
        bool sweptBearBreach = low < bearBreachLow and close > bearBreachLow and close < bearBreachHigh
        bool closedBearBreach = close < bearBreachLow
        if not bearBreachSwept and sweptBearBreach
            bearBreachSwept := true
            bearContSweepBar := bar_index
            bearContSweepPrice := low
        else if bearBreachSwept and closedBearBreach
            continuationDir := DIR_BEAR
            bearBreachBar := na
            bearBreachSwept := false
        else if closedBearBreach
            bearBreachBar := bar_index
            bearBreachHigh := high
            bearBreachLow := low
            bearBreachSwept := false
        else if close > bearBreachHigh
            bearBreachBar := na
            bearBreachSwept := false
    if bullSweepValid and not na(lastBullSweepBar) and bar_index != lastBullSweepBar and close < bullSweepLevel
        bearBreachBar := bar_index
        bearBreachHigh := high
        bearBreachLow := low
        bearBreachSwept := false
        bullSweepValid := false
        bullSweepCandle := na
        firstBullSweepBar := na
        firstBullSweepPrice := na
    if bearSweepValid and not na(lastBearSweepBar) and bar_index != lastBearSweepBar and close > bearSweepLevel
        bullBreachBar := bar_index
        bullBreachHigh := high
        bullBreachLow := low
        bullBreachSwept := false
        bearSweepValid := false
        bearSweepCandle := na
        firstBearSweepBar := na
        firstBearSweepPrice := na

// Key Level starts on an untapped side of the last closed key candle. A sweep
// or a close through that side opens the watch. A later chart candle has to
// close back inside that candle's range. Liquidity Lookback counts from that
// close. The liquidity sweep can be older. One side of a key candle arms once,
// and a later close through the same side opens the watch again.
string keySelected = keyLevelChoice == "Same" ? targetChoice : keyLevelChoice
string keyPine = keySelected == "Daily" ? "D" : keySelected == "4H" ? "240" : keySelected == "1H" ? "60" : keySelected == "15M" ? "15" : keySelected == "5M" ? "5" : keySelected == "1M" ? "1" : timeframe.period
bool keyTfOk = keySelected != "Off" and timeframe.in_seconds(keyPine) >= timeframe.in_seconds()
bool keyLevelOn = keyLevelChoice != "Off" and keyTfOk
string safeKeyPine = keyLevelOn ? keyPine : timeframe.period
[closedKeyTime, closedKeyHigh, closedKeyLow] = request.security(
     syminfo.tickerid, safeKeyPine, [time[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
var int keyCandleTime = na
var bool keyBullUntapped = true
var bool keyBearUntapped = true
var bool keyBullTapped = false
var bool keyBearTapped = false
var float keyBullRangeHigh = na
var float keyBullRangeLow = na
var float keyBearRangeHigh = na
var float keyBearRangeLow = na
var int lastKeyBullBar = na
var int lastKeyBearBar = na
var bool keyBullValid = false
var bool keyBearValid = false
if barstate.isconfirmed and keyLevelOn and not na(closedKeyTime) and not na(closedKeyHigh) and not na(closedKeyLow) and closedKeyHigh > closedKeyLow
    if na(keyCandleTime) or closedKeyTime != keyCandleTime
        keyCandleTime := closedKeyTime
        keyBullUntapped := true
        keyBearUntapped := true
    bool sweptOrTraversedLow = low < closedKeyLow or close < closedKeyLow
    bool sweptOrTraversedHigh = high > closedKeyHigh or close > closedKeyHigh
    if keyBullUntapped and sweptOrTraversedLow
        keyBullUntapped := false
        keyBullTapped := true
        keyBullRangeHigh := closedKeyHigh
        keyBullRangeLow := closedKeyLow
        keyBullValid := false
        lastKeyBullBar := na
    if keyBearUntapped and sweptOrTraversedHigh
        keyBearUntapped := false
        keyBearTapped := true
        keyBearRangeHigh := closedKeyHigh
        keyBearRangeLow := closedKeyLow
        keyBearValid := false
        lastKeyBearBar := na
    if keyBullTapped and not keyBullValid and close <= keyBullRangeHigh and close >= keyBullRangeLow
        keyBullValid := true
        lastKeyBullBar := bar_index
        keyBullTapped := false
    if keyBearTapped and not keyBearValid and close <= keyBearRangeHigh and close >= keyBearRangeLow
        keyBearValid := true
        lastKeyBearBar := bar_index
        keyBearTapped := false
    if keyBullValid and not na(lastKeyBullBar) and bar_index != lastKeyBullBar and close < keyBullRangeLow
        keyBullValid := false
        keyBullTapped := true
        lastKeyBullBar := na
    if keyBearValid and not na(lastKeyBearBar) and bar_index != lastKeyBearBar and close > keyBearRangeHigh
        keyBearValid := false
        keyBearTapped := true
        lastKeyBearBar := na

f_keyOk(bool bullish) =>
    bool allowed = true
    if keyLevelOn
        int keyBar = bullish ? lastKeyBullBar : lastKeyBearBar
        bool keyValid = bullish ? keyBullValid : keyBearValid
        allowed := liquidityOn and keyValid and not na(keyBar) and bar_index - keyBar <= liquidityLookback
    allowed

f_liquidityOk(bool bullish) =>
    bool allowed = true
    if liquidityOn
        int sweepBar = bullish ? lastBullSweepBar : lastBearSweepBar
        bool sweepValid = bullish ? bullSweepValid : bearSweepValid
        if keyLevelOn
            allowed := sweepValid and not na(sweepBar)
        else
            allowed := sweepValid and not na(sweepBar) and bar_index - sweepBar <= liquidityLookback
    allowed and f_keyOk(bullish)

// A later mark of the same price, side, and pool deletes the earlier line and
// label. The level keeps the latest label.
f_dropSameSweep(float price, int side, int kind) =>
    int count = array.size(sweepLabels)
    if count > 0
        for index = count - 1 to 0
            line drawnLine = array.get(sweepLines, index)
            bool sameLevel = array.get(sweepLabelSides, index) == side and array.get(sweepLabelKinds, index) == kind and not na(drawnLine) and line.get_y1(drawnLine) == price
            if sameLevel
                label.delete(array.get(sweepLabels, index))
                line.delete(drawnLine)
                array.remove(sweepLabels, index)
                array.remove(sweepLines, index)
                array.remove(sweepLabelBars, index)
                array.remove(sweepLabelSides, index)
                array.remove(sweepLabelKinds, index)

// Drawn when the mark is shown. The line runs from the swept candle to this mark,
// and the label sits on that line. Removing the mark removes the line.
f_markSweptLevel(int anchorBar, float price, int side, int kind, string markText) =>
    line markLine = na
    label markLabel = na
    if not na(anchorBar) and not na(price)
        f_dropSameSweep(price, side, kind)
        bool bullishSweep = side == DIR_BULL
        color markColor = bullishSweep ? bullObColor : bearObColor
        int lineRight = math.max(anchorBar + 1, bar_index)
        markLine := line.new(anchorBar, price, lineRight, price,
             xloc = xloc.bar_index, color = markColor, style = line.style_dashed, width = 1)
        markLabel := label.new(lineRight, price, markText,
             xloc = xloc.bar_index, yloc = yloc.price, color = markColor,
             style = label.style_label_left, textcolor = color.white, size = size.small,
             tooltip = "Swept " + str.tostring(price, format.mintick) + " and closed back inside")
        array.push(sweepLines, markLine)
        array.push(sweepLabels, markLabel)
        array.push(sweepLabelBars, anchorBar)
        array.push(sweepLabelSides, side)
        array.push(sweepLabelKinds, kind)
        while array.size(sweepLabels) > 50
            label.delete(array.shift(sweepLabels))
            line.delete(array.shift(sweepLines))
            array.shift(sweepLabelBars)
            array.shift(sweepLabelSides)
            array.shift(sweepLabelKinds)
    [markLine, markLabel]

f_labelFirstSweep(Formation formation) =>
    bool labeled = false
    if liquidityOn and not na(formation.sweepBar) and not na(formation.sweepPrice)
        bool bullishSweep = formation.direction == DIR_BULL
        [markLine, markLabel] = f_markSweptLevel(formation.sweepBar, formation.sweepPrice, formation.direction, 1, liquiditySelected + " Sweep")
        formation.sweepLine := markLine
        formation.sweepTag := markLabel
        labeled := not na(markLabel)
        if keyLevelOn
            int keyBar = bullishSweep ? lastKeyBullBar : lastKeyBearBar
            float keyPrice = bullishSweep ? keyBullRangeLow : keyBearRangeHigh
            bool keyValid = bullishSweep ? keyBullValid : keyBearValid
            if keyValid and not na(keyBar) and not na(keyPrice)
                [keyLine, keyLabel] = f_markSweptLevel(keyBar, keyPrice, formation.direction, 2, keySelected + " Sweep")
                formation.keySweepLine := keyLine
                formation.keySweepTag := keyLabel
                labeled := labeled or not na(keyLabel)
    labeled

latestSwing(float price, bool bullish) =>
    float foundPrice = na
    int foundTime = na
    int kind = bullish ? 1 : -1
    int count = array.size(targetSwingPrices)
    if not na(price) and count > 0
        for swingIndex = count - 1 to 0
            float swingPrice = array.get(targetSwingPrices, swingIndex)
            bool beyond = bullish ? swingPrice > price : swingPrice < price
            if array.get(targetSwingKinds, swingIndex) == kind and beyond
                foundPrice := swingPrice
                foundTime := array.get(targetSwingTimes, swingIndex)
                break
    [foundPrice, foundTime]

f_target(float entry, float stopLevel, bool bullish) =>
    float risk = bullish ? entry - stopLevel : stopLevel - entry
    float resultPrice = na
    int resultTime = na
    bool underMin = false
    // The final target decides the mark: the swing, the two-times fallback, or the Max Target cap.
    bool htfTooClose = false
    bool stopOk = risk > 0
    if targetOn and stopOk
        if swingTargetOn
            [swingPrice, swingTime] = latestSwing(entry, bullish)
            resultPrice := na(swingPrice) ? (bullish ? entry + risk * 2 : entry - risk * 2) : swingPrice
            resultTime := na(swingPrice) ? na : swingTime
        else if maxTarget > 0
            resultPrice := bullish ? entry + risk * maxTarget : entry - risk * maxTarget
        float reward = na(resultPrice) ? na : (bullish ? resultPrice - entry : entry - resultPrice)
        if maxTarget > 0 and not na(resultTime) and not na(reward) and reward > maxTarget * risk
            resultPrice := bullish ? entry + risk * maxTarget : entry - risk * maxTarget
            resultTime := na
            reward := maxTarget * risk
        if minRr > 0 and (na(reward) or reward < minRr * risk)
            htfTooClose := true
            underMin := true
        if na(resultPrice) or na(reward) or reward < risk
            resultPrice := na
            resultTime := na
            underMin := false
    else if minRr > 0
        htfTooClose := true
    [resultPrice, resultTime, underMin, htfTooClose]

// Market at close reprices the entry, the target, and Min RR from the close
// passed in. A swing break passes the displacement candle. A flip passes the
// flip candle. Limit at the swing keeps the swing prices. A stop on the wrong
// side of that close leaves the mark off. The market level is one expression
// so the returned price is that close on every bar the option is on.
f_resolveEntry(float swingLevel, float stopLevel, float swingTarget, int swingAnchor, bool swingUnder, bool swingTooClose, bool bullish, float marketPrice) =>
    bool stopSide = bullish ? stopLevel < marketPrice : stopLevel > marketPrice
    [marketTarget, marketAnchor, marketUnder, marketTooClose] = f_target(marketPrice, stopLevel, bullish)
    float level = marketEntry ? marketPrice : swingLevel
    float target = marketEntry ? (stopSide ? marketTarget : na) : swingTarget
    int anchor = marketEntry ? (stopSide ? marketAnchor : na) : swingAnchor
    bool under = marketEntry ? (stopSide ? marketUnder : false) : swingUnder
    bool tooClose = marketEntry ? (stopSide ? marketTooClose : true) : swingTooClose
    [level, target, anchor, under, tooClose]

float pivotHigh = ta.pivothigh(high, swingLength, swingLength)
float pivotLow = ta.pivotlow(low, swingLength, swingLength)

var float swingHigh = na
var int swingHighBar = na
var float swingLow = na
var int swingLowBar = na
var int brokenHighBar = na
var int brokenLowBar = na
// Armed on the candle that closes through the swing. Drawn on the next bar
// only when that swing sits inside the body gap.
var int armedDirection = 0
var int armedKind = 0
var int armedBar = na
var int armedSwingBar = na
var float armedLevel = na
var int armedObBar = na
var float armedObTop = na
var float armedObBottom = na
var float armedCandle1BodyHigh = na
var float armedCandle1BodyLow = na
var float armedHigh = na
var float armedLow = na
var float armedStop = na
var float armedTarget = na
var int armedTime = na
var int armedTargetTime = na
var bool armedUnder = false
var float armedSwingStop = na
var float armedSwingTarget = na
var int armedSwingTargetTime = na
var bool armedSwingTooClose = true
var int armedSweepBar = na
var float armedSweepPrice = na

if not na(pivotHigh)
    swingHigh := pivotHigh
    swingHighBar := bar_index - swingLength

if not na(pivotLow)
    swingLow := pivotLow
    swingLowBar := bar_index - swingLength

bool swingHighOpen = not na(swingHigh) and (na(brokenHighBar) or brokenHighBar != swingHighBar)
bool swingLowOpen = not na(swingLow) and (na(brokenLowBar) or brokenLowBar != swingLowBar)
// The mark is the candle that closes through the swing. An unclaimed close
// through is booked when Swing Breach Lookback expires. A wick that never
// closes through does not book the swing.
var int bullCloseBar = na
var int bullWatchBar = na
var int bearCloseBar = na
var int bearWatchBar = na
if not na(swingHighBar) and swingHighBar != bullWatchBar
    bullWatchBar := swingHighBar
    bullCloseBar := na
if not na(swingLowBar) and swingLowBar != bearWatchBar
    bearWatchBar := swingLowBar
    bearCloseBar := na
if barstate.isconfirmed and swingHighOpen and na(bullCloseBar) and close > swingHigh and close[1] <= swingHigh
    bullCloseBar := bar_index
if barstate.isconfirmed and swingLowOpen and na(bearCloseBar) and close < swingLow and close[1] >= swingLow
    bearCloseBar := bar_index
int bullCloseAge = na(bullCloseBar) ? na : bar_index - bullCloseBar
int bearCloseAge = na(bearCloseBar) ? na : bar_index - bearCloseBar
// A close inside Close Location still books the swing. It does not arm.
f_committed(bool bullish) =>
    float span = high - low
    float location = bullish ? close - low : high - close
    closeLocation == 0 or (span > 0 and location >= span * closeLocation)
bool bullishBreakNow = barstate.isconfirmed and swingHighOpen and close > swingHigh and close[1] <= swingHigh and close > open and f_committed(true)
bool bearishBreakNow = barstate.isconfirmed and swingLowOpen and close < swingLow and close[1] >= swingLow and close < open and f_committed(false)

// The next candle confirms when the broken swing sits strictly inside the body
// gap. A bullish gap needs the previous body high below the swing and this
// body low above it. A bearish gap is the mirror. Color does not matter.
// This candle's wick has to stay beyond the swing. A wick back through it
// leaves the setup undrawn. Skip Sundays leaves the swing unused and leaves the
// current mark in place.
bool sundaySkipped = skipSundays and dayofweek(time, timeZone) == dayofweek.sunday
bool formedThisBar = false
// The previous market fill gets its stop on this candle. A limit is sent on this candle, one candle after its mark.
if barstate.isconfirmed and array.size(formations) > 0
    int waitingCount = array.size(formations)
    for waitIndex = 0 to waitingCount - 1
        Formation waiting = array.get(formations, waitIndex)
        bool waitingDue = not na(waiting.entryDrawnBar) and bar_index > waiting.entryDrawnBar
        if waiting.protectWaiting and waitingDue
            waiting.protectWaiting := false
            f_protect(waiting)
        if waiting.swingLimitWaiting and waitingDue
            waiting.swingLimitWaiting := false
            f_placeSwing(waiting)
        if waiting.limitWaiting and waitingDue and strategy.position_size == 0
            waiting.limitWaiting := false
            f_place(waiting)
if barstate.isconfirmed and armedDirection != 0
    if bar_index == armedBar + 1 and not sundaySkipped
        float candle3BodyHigh = math.max(open, close)
        float candle3BodyLow = math.min(open, close)
        bool confirmedFvg = armedDirection == DIR_BULL ?
             armedLevel > armedCandle1BodyHigh and armedLevel < candle3BodyLow and low > armedLevel :
             armedLevel < armedCandle1BodyLow and armedLevel > candle3BodyHigh and high < armedLevel
        bool liquidityStill = not liquidityOn or (armedDirection == DIR_BULL ? bullSweepValid : bearSweepValid)
        bool keyStill = not keyLevelOn or (armedDirection == DIR_BULL ? keyBullValid : keyBearValid)
        bool sweepStillValid = liquidityStill and keyStill and (liquidityOn or not keyLevelOn)
        bool confirmWindow = marketEntry or f_inWindow()
        bool bothWindow = bothEntry and (marketOrderLive or f_inWindow())
        if confirmedFvg and sweepStillValid and (confirmWindow or bothWindow)
            float displacementClose = close[1]
            [resolvedLevel, useTarget, useAnchor, useUnder, useTooClose] = f_resolveEntry(armedLevel, armedStop, armedTarget, armedTargetTime, armedUnder, false, armedDirection == DIR_BULL, displacementClose)
            float useLevel = marketEntry ? displacementClose : resolvedLevel
            if bothEntry
                bool limitLeg = not armedSwingTooClose and f_inWindow()
                bool marketLeg = marketOrderLive
                if marketLeg or limitLeg
                    float gapTop = armedDirection == DIR_BULL ? candle3BodyLow : armedCandle1BodyLow
                    float gapBottom = armedDirection == DIR_BULL ? armedCandle1BodyHigh : candle3BodyHigh
                    float primaryLevel = marketLeg ? displacementClose : armedLevel
                    float primaryStop = marketLeg ? armedStop : armedSwingStop
                    float primaryTarget = marketLeg ? armedTarget : armedSwingTarget
                    int primaryAnchor = marketLeg ? armedTargetTime : armedSwingTargetTime
                    Formation formation = Formation.new(armedDirection, armedKind, armedBar, armedSwingBar, primaryLevel,
                         armedObBar, armedObTop, armedObBottom, armedBar - 1, bar_index, gapTop, gapBottom,
                         false, false, false, armedHigh, armedLow, primaryStop, primaryTarget, armedTime, primaryAnchor, armedUnder, false,
                         na, na, na, na, na, na, na)
                    formation.closeLines := marketLeg
                    if marketLeg and limitLeg
                        formation.swingLevel := armedLevel
                        formation.swingStop := armedSwingStop
                        formation.swingTarget := armedSwingTarget
                    formation.sweepBar := armedSweepBar
                    formation.sweepPrice := armedSweepPrice
                    formation.opposingSwing := armedDirection == DIR_BULL ? swingLow : swingHigh
                    if f_store(formation)
                        f_labelFirstSweep(formation)
                        if marketLeg
                            f_show(formation, false)
                            f_protect(formation)
                            if limitLeg
                                formation.swingLimitWaiting := true
                            formedThisBar := true
                        else
                            f_show(formation, true)
                            formedThisBar := true
                    else if marketOrderLive
                        f_closeMarket(armedDirection)
                        formedThisBar := false
                else if marketOrderLive
                    f_closeMarket(armedDirection)
                    formedThisBar := false
            else if not useTooClose
                float gapTop = armedDirection == DIR_BULL ? candle3BodyLow : armedCandle1BodyLow
                float gapBottom = armedDirection == DIR_BULL ? armedCandle1BodyHigh : candle3BodyHigh
                Formation formation = Formation.new(armedDirection, armedKind, armedBar, armedSwingBar, useLevel,
                     armedObBar, armedObTop, armedObBottom, armedBar - 1, bar_index, gapTop, gapBottom,
                     false, false, false, armedHigh, armedLow, armedStop, useTarget, armedTime, useAnchor, useUnder, false,
                     na, na, na, na, na, na, na)
                formation.sweepBar := armedSweepBar
                formation.sweepPrice := armedSweepPrice
                formation.opposingSwing := armedDirection == DIR_BULL ? swingLow : swingHigh
                if f_store(formation)
                    if marketOrderLive
                        f_show(formation, false)
                        f_protect(formation)
                    else
                        f_show(formation, true)
                    f_labelFirstSweep(formation)
                    formedThisBar := true
                else if marketOrderLive
                    f_closeMarket(armedDirection)
                    formedThisBar := false
            else if marketOrderLive
                f_closeMarket(armedDirection)
                formedThisBar := false
        else if marketOrderLive
            f_closeMarket(armedDirection)
            formedThisBar := false
        marketOrderLive := false
    else if marketOrderLive
        f_closeMarket(armedDirection)
        marketOrderLive := false
    armedDirection := 0

// A close through the marked candle, in the opposite direction, is the new
// mark. The fair value gap does not apply. The time window does. Min RR does.
// Close Location does. A close inside that fraction is not a flip, so the
// working mark and its limit stay. A liquidity sweep outside the lookback
// means this flip is not considered, so the working mark and its limit stay.
// Below Min RR, or outside the window, the old mark is removed and nothing is
// drawn. A wick through the candle does not. Skip Sundays leaves the mark in place.
bool flippedThisBar = false
if barstate.isconfirmed and not sundaySkipped and array.size(formations) > 0
    Formation zone = array.get(formations, array.size(formations) - 1)
    bool brokeOpposingSwing = (zone.direction == DIR_BEAR and bullishBreakNow) or (zone.direction == DIR_BULL and bearishBreakNow)
    bool closedBullZone = zone.direction == DIR_BULL and not zone.flipped and bar_index > zone.creationBar + 1 and
         close < open and close < zone.impulseLow and not brokeOpposingSwing
    bool closedBearZone = zone.direction == DIR_BEAR and not zone.flipped and bar_index > zone.creationBar + 1 and
         close > open and close > zone.impulseHigh and not brokeOpposingSwing
    bool flipCommitted = (closedBullZone and f_committed(false)) or (closedBearZone and f_committed(true))
    if flipCommitted
        int flipDirection = closedBullZone ? DIR_BEAR : DIR_BULL
        bool flipLiquidity = f_liquidityOk(flipDirection == DIR_BULL)
        if flipLiquidity
            int flipKind = structureDirection == flipDirection ? KIND_BOS : KIND_MSS
            float flipLevel = na
            int flipSwingBar = na
            if flipDirection == DIR_BULL and not na(swingHigh) and close > swingHigh
                flipLevel := swingHigh
                flipSwingBar := swingHighBar
                if swingHighOpen
                    brokenHighBar := swingHighBar
            else if flipDirection == DIR_BEAR and not na(swingLow) and close < swingLow
                flipLevel := swingLow
                flipSwingBar := swingLowBar
                if swingLowOpen
                    brokenLowBar := swingLowBar
            float flipStop = marketEntry ? open : (flipDirection == DIR_BULL ? low[1] : high[1])
            [swingTarget, swingAnchor, swingUnder, swingTooClose] = f_target(flipLevel, flipStop, flipDirection == DIR_BULL)
            [resolvedLevel, useTarget, useAnchor, useUnder, flipTooClose] = f_resolveEntry(flipLevel, flipStop, swingTarget, swingAnchor, swingUnder, swingTooClose, flipDirection == DIR_BULL, close)
            float useLevel = marketEntry ? close : resolvedLevel
            bool limitTooClose = flipTooClose
            float bothOpen = open
            float bothClose = close
            bool bothMarketTooClose = true
            float bothMarketTarget = na
            int bothMarketAnchor = na
            bool bothMarketUnder = false
            if bothEntry
                [bothMarketTarget, bothMarketAnchor, bothMarketUnder, bothMarketTooClose] = f_target(bothClose, bothOpen, flipDirection == DIR_BULL)
                flipTooClose := bothMarketTooClose and limitTooClose
            bool marketLeg = bothEntry and not bothMarketTooClose
            bool limitLeg = bothEntry and not limitTooClose
            bool flipWindow = f_inWindow()
            zone.flipped := true
            structureDirection := flipDirection
            Formation flipFormation = Formation.new(flipDirection, flipKind, bar_index, flipSwingBar, useLevel,
                 zone.creationBar, zone.impulseHigh, zone.impulseLow, zone.creationBar, bar_index, high, low,
                 false, false, false, high, low, flipStop, useTarget, time, useAnchor, useUnder, false,
                 na, na, na, na, na, na, na)
            flipFormation.sweepBar := flipDirection == DIR_BULL ? firstBullSweepBar : firstBearSweepBar
            flipFormation.sweepPrice := flipDirection == DIR_BULL ? firstBullSweepPrice : firstBearSweepPrice
            flipFormation.opposingSwing := flipDirection == DIR_BULL ? swingLow : swingHigh
            if marketLeg
                flipFormation.level := bothClose
                flipFormation.stopPrice := bothOpen
                flipFormation.targetPrice := bothMarketTarget
                flipFormation.targetAnchorTime := bothMarketAnchor
                flipFormation.underMinRr := bothMarketUnder
                flipFormation.closeLines := true
                if limitLeg
                    flipFormation.swingLevel := useLevel
                    flipFormation.swingStop := flipStop
                    flipFormation.swingTarget := useTarget
            if flipTooClose or not flipWindow
                f_deleteVisuals(zone)
                if strategy.position_size == 0 and zone.creationBar == array.get(pendingCreation, 0)
                    f_clearPending()
                f_store(flipFormation)
            else if f_store(flipFormation)
                if bothEntry and strategy.position_size == 0
                    if marketLeg and f_entryOk(flipDirection, bothClose, bothOpen)
                        f_clearPending()
                        if flipDirection == DIR_BULL
                            strategy.entry("1C Long", strategy.long, qty = contracts)
                            flipFormation.protectWaiting := true
                        else
                            strategy.entry("1C Short", strategy.short, qty = contracts)
                            flipFormation.protectWaiting := true
                        array.set(pendingCreation, 0, flipFormation.creationBar)
                        if limitLeg
                            flipFormation.swingLimitWaiting := true
                        f_show(flipFormation, false)
                    else
                        f_show(flipFormation, true)
                else
                    f_show(flipFormation, true)
                f_labelFirstSweep(flipFormation)
                formedThisBar := true
            flippedThisBar := true

// An opposite swing break after a mark uses the same arm as any other break.
// Liquidity Lookback has to pass on this candle. The order and the box wait
// for the next candle to leave the swing inside the body gap.
if not sundaySkipped and not flippedThisBar and bullishBreakNow and f_inWindow()
    int kind = structureDirection == DIR_BULL ? KIND_BOS : KIND_MSS
    structureDirection := DIR_BULL
    brokenHighBar := swingHighBar
    [targetPrice, targetAnchor, underMinRr, htfTooClose] = f_target(swingHigh, low[1], true)
    // A final target inside Min RR, or a sweep outside the lookback, is booked and left unmarked.
    // Market at close checks Min RR on the displacement close, against that candle's open.
    float bullArmClose = close
    float bullArmOpen = open
    bool bullArmTooClose = true
    float bullArmTarget = na
    int bullArmAnchor = na
    bool bullArmUnder = false
    if marketEntry or bothEntry
        [bullArmTarget, bullArmAnchor, bullArmUnder, bullArmTooClose] = f_target(bullArmClose, bullArmOpen, true)
    bool swingArm = (marketEntry or not htfTooClose) and f_liquidityOk(true)
    bool bothArm = bothEntry and f_liquidityOk(true) and (not htfTooClose or not bullArmTooClose)
    if swingArm or bothArm
        armedDirection := DIR_BULL
        armedKind := kind
        armedBar := bar_index
        armedSwingBar := swingHighBar
        armedLevel := swingHigh
        armedObBar := bar_index
        armedObTop := high
        armedObBottom := low
        armedCandle1BodyHigh := math.max(open[1], close[1])
        armedCandle1BodyLow := math.min(open[1], close[1])
        armedHigh := high
        armedLow := low
        armedStop := low[1]
        armedSwingStop := low[1]
        armedSwingTarget := targetPrice
        armedSwingTargetTime := targetAnchor
        armedSwingTooClose := htfTooClose
        armedTarget := targetPrice
        armedTime := time
        armedTargetTime := targetAnchor
        armedUnder := underMinRr
        if marketEntry or bothEntry
            armedStop := open
            armedTarget := bullArmTarget
            armedTargetTime := bullArmAnchor
            armedUnder := bullArmUnder
            // The fill is this candle's close. The next candle attaches the stop when the gap confirms.
            if not bullArmTooClose and strategy.position_size == 0 and f_entryOk(DIR_BULL, close, open)
                f_clearPending()
                strategy.entry("1C Long", strategy.long, qty = contracts)
                marketOrderLive := true
                array.set(pendingCreation, 0, bar_index)
        armedSweepBar := firstBullSweepBar
        armedSweepPrice := firstBullSweepPrice
else if not sundaySkipped and not flippedThisBar and barstate.isconfirmed and swingHighOpen and not na(bullCloseAge) and bullCloseAge == swingBreachLookback
    structureDirection := DIR_BULL
    brokenHighBar := swingHighBar

if not sundaySkipped and not flippedThisBar and bearishBreakNow and f_inWindow()
    int kind = structureDirection == DIR_BEAR ? KIND_BOS : KIND_MSS
    structureDirection := DIR_BEAR
    brokenLowBar := swingLowBar
    [targetPrice, targetAnchor, underMinRr, htfTooClose] = f_target(swingLow, high[1], false)
    float bearArmClose = close
    float bearArmOpen = open
    bool bearArmTooClose = true
    float bearArmTarget = na
    int bearArmAnchor = na
    bool bearArmUnder = false
    if marketEntry or bothEntry
        [bearArmTarget, bearArmAnchor, bearArmUnder, bearArmTooClose] = f_target(bearArmClose, bearArmOpen, false)
    bool bearSwingArm = (marketEntry or not htfTooClose) and f_liquidityOk(false)
    bool bearBothArm = bothEntry and f_liquidityOk(false) and (not htfTooClose or not bearArmTooClose)
    if bearSwingArm or bearBothArm
        armedDirection := DIR_BEAR
        armedKind := kind
        armedBar := bar_index
        armedSwingBar := swingLowBar
        armedLevel := swingLow
        armedObBar := bar_index
        armedObTop := high
        armedObBottom := low
        armedCandle1BodyHigh := math.max(open[1], close[1])
        armedCandle1BodyLow := math.min(open[1], close[1])
        armedHigh := high
        armedLow := low
        armedStop := high[1]
        armedSwingStop := high[1]
        armedSwingTarget := targetPrice
        armedSwingTargetTime := targetAnchor
        armedSwingTooClose := htfTooClose
        armedTarget := targetPrice
        armedTime := time
        armedTargetTime := targetAnchor
        armedUnder := underMinRr
        if marketEntry or bothEntry
            armedStop := open
            armedTarget := bearArmTarget
            armedTargetTime := bearArmAnchor
            armedUnder := bearArmUnder
            if not bearArmTooClose and strategy.position_size == 0 and f_entryOk(DIR_BEAR, close, open)
                f_clearPending()
                strategy.entry("1C Short", strategy.short, qty = contracts)
                marketOrderLive := true
                array.set(pendingCreation, 0, bar_index)
        armedSweepBar := firstBearSweepBar
        armedSweepPrice := firstBearSweepPrice
else if not sundaySkipped and not flippedThisBar and barstate.isconfirmed and swingLowOpen and not na(bearCloseAge) and bearCloseAge == swingBreachLookback
    structureDirection := DIR_BEAR
    brokenLowBar := swingLowBar

// A continuation arms on this candle when Liquidity Lookback passes. The entry
// is this close and the stop is this open. The box waits for the next candle
// to leave that close inside the body gap, with its wick beyond that close.
// A flat account takes the close now and the next candle closes it when the
// gap fails. Session VWAP matches the chart VWAP. The chase check is only for a continuation.
float sessionVwap = ta.vwap(hlc3)
if continuationDir != 0 and barstate.isconfirmed and not sundaySkipped and not flippedThisBar and not formedThisBar and armedDirection == 0 and f_inWindow()
    bool continuationBull = continuationDir == DIR_BULL
    float continuationClose = close
    float continuationOpen = open
    bool continuationStopSide = continuationBull ? continuationOpen < continuationClose : continuationOpen > continuationClose
    float continuationRisk = math.abs(continuationClose - continuationOpen)
    float vwapDistance = continuationBull ? continuationClose - sessionVwap : sessionVwap - continuationClose
    bool vwapChased = useVwapChase and not na(sessionVwap) and continuationRisk > 0 and vwapDistance > vwapChase * continuationRisk
    [continuationTarget, continuationAnchor, continuationUnder, continuationTooClose] = f_target(continuationClose, continuationOpen, continuationBull)
    bool continuationLiquidity = f_liquidityOk(continuationBull)
    if continuationStopSide and not continuationTooClose and not vwapChased and f_keyOk(continuationBull) and f_committed(continuationBull) and continuationLiquidity
        int continuationKind = structureDirection == continuationDir ? KIND_BOS : KIND_MSS
        structureDirection := continuationDir
        armedDirection := continuationDir
        armedKind := continuationKind
        armedBar := bar_index
        armedSwingBar := bar_index
        armedLevel := continuationClose
        armedObBar := bar_index
        armedObTop := high
        armedObBottom := low
        armedCandle1BodyHigh := math.max(open[1], close[1])
        armedCandle1BodyLow := math.min(open[1], close[1])
        armedHigh := high
        armedLow := low
        armedStop := continuationOpen
        armedSwingStop := continuationOpen
        armedSwingTarget := continuationTarget
        armedSwingTargetTime := continuationAnchor
        armedSwingTooClose := continuationTooClose
        armedTarget := continuationTarget
        armedTime := time
        armedTargetTime := continuationAnchor
        armedUnder := continuationUnder
        armedSweepBar := continuationBull ? firstBullSweepBar : firstBearSweepBar
        armedSweepPrice := continuationBull ? firstBullSweepPrice : firstBearSweepPrice
        bool continuationTake = strategy.position_size == 0 and f_entryOk(continuationDir, continuationClose, continuationOpen)
        if continuationTake and continuationBull
            f_clearPending()
            strategy.entry("1C Long", strategy.long, qty = contracts)
            marketOrderLive := true
            array.set(pendingCreation, 0, bar_index)
        if continuationTake and not continuationBull
            f_clearPending()
            strategy.entry("1C Short", strategy.short, qty = contracts)
            marketOrderLive := true
            array.set(pendingCreation, 0, bar_index)
continuationDir := 0

// The candle that leaves the gap is not a fill. A later bar that trades into
// the gap or the order block marks that zone touched.
int formationCount = array.size(formations)
if barstate.isconfirmed and formationCount > 0
    for index = 0 to formationCount - 1
        Formation formation = array.get(formations, index)
        if bar_index > formation.creationBar and not formation.obMitigated and f_touched(formation.obTop, formation.obBottom)
            formation.obMitigated := true
        if bar_index > formation.creationBar + 1 and not formation.fvgMitigated and f_touched(formation.fvgTop, formation.fvgBottom)
            formation.fvgMitigated := true
        // A stop traded after the drawing candle hides the mark, including a stop after the entry.
        // The working limit is cancelled only when the stop is traded before the entry.
        // A market order is left to fill. Its stop and target belong to the open trade.
        if formation.isVisible and not na(formation.entryDrawnBar) and bar_index > formation.entryDrawnBar
            bool entryTouched = not na(formation.level) and high >= formation.level and low <= formation.level
            bool stopTouched = high >= formation.stopPrice and low <= formation.stopPrice
            bool swingOn = not na(formation.swingLevel) and not na(formation.swingStop)
            bool swingEntryTouched = swingOn and high >= formation.swingLevel and low <= formation.swingLevel
            bool swingStopTouched = swingOn and high >= formation.swingStop and low <= formation.swingStop
            bool swingStill = swingOn and not formation.swingEntryMitigated and not (swingStopTouched and not swingEntryTouched)
            if swingOn and not formation.swingEntryMitigated
                if swingStopTouched and not swingEntryTouched
                    line.delete(formation.swingEntryLine)
                    line.delete(formation.swingStopLine)
                    line.delete(formation.swingTargetLine)
                    formation.swingEntryLine := na
                    formation.swingStopLine := na
                    formation.swingTargetLine := na
                    formation.swingEntryMitigated := true
                    formation.swingLevel := na
                    strategy.cancel("1C Long Limit")
                    strategy.cancel("1C Short Limit")
                    formation.swingLimitWaiting := false
                else if not na(formation.swingEntryLine)
                    int swingRight = bar_index + 1
                    line.set_x2(formation.swingEntryLine, swingRight)
                    line.set_x2(formation.swingStopLine, swingRight)
                    if not na(formation.swingTargetLine)
                        line.set_x2(formation.swingTargetLine, swingRight)
                    if swingEntryTouched
                        formation.swingEntryMitigated := true
            if stopTouched
                if swingStill
                    line.delete(formation.entryLine)
                    line.delete(formation.stopLine)
                    line.delete(formation.targetLine)
                    formation.entryLine := na
                    formation.stopLine := na
                    formation.targetLine := na
                    formation.entryMitigated := true
                else
                    f_deleteVisuals(formation)
                    if not marketEntry and not entryTouched and strategy.position_size == 0 and formation.creationBar == array.get(pendingCreation, 0)
                        f_clearPending()
            else if not formation.entryMitigated and not na(formation.entryLine)
                int lineRight = bar_index + 1
                line.set_x2(formation.entryLine, lineRight)
                line.set_x2(formation.stopLine, lineRight)
                if not na(formation.targetLine)
                    line.set_x2(formation.targetLine, lineRight)
                if entryTouched
                    formation.entryMitigated := true
                    if formation.creationBar == array.get(pendingCreation, 0)
                        array.set(pendingCreation, 0, na)

// A same-session trade opened before 15:55 is closed on the first bar at or after 15:55.
// The entry bar is skipped. A fill at 15:55 or later is not flattened, and neither is a trade held past midnight.
bool sessionFlatDue = false
if sessionFlat and strategy.position_size != 0 and strategy.opentrades > 0
    int flatEntryTime = strategy.opentrades.entry_time(0)
    int flatEntryDay = year(flatEntryTime, timeZone) * 10000 + month(flatEntryTime, timeZone) * 100 + dayofmonth(flatEntryTime, timeZone)
    int flatBarDay = year(time, timeZone) * 10000 + month(time, timeZone) * 100 + dayofmonth(time, timeZone)
    int flatEntryMinute = hour(flatEntryTime, timeZone) * 60 + minute(flatEntryTime, timeZone)
    int flatBarMinute = hour(time, timeZone) * 60 + minute(time, timeZone)
    bool flatSame = flatEntryDay == flatBarDay and flatEntryMinute < 15 * 60 + 55
    bool flatClock = flatBarMinute >= 15 * 60 + 55
    bool flatLive = bar_index > strategy.opentrades.entry_bar_index(0)
    sessionFlatDue := flatSame and flatClock and flatLive
if sessionFlatDue
    strategy.close("1C Long", comment = "session")
    strategy.close("1C Short", comment = "session")
    strategy.close("1C Long Limit", comment = "session")
    strategy.close("1C Short Limit", comment = "session")
